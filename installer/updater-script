check_part_size() {
    local name="$1" block="$2" need="$3" have
    [ -n "$block" ] || abort "Missing $name partition block"
    have=$(blockdev --getsize64 "$block" 2>/dev/null)
    [ -n "$have" ] || abort "Cannot read $name partition size"
    ui_print "   - $name size: $have bytes"
    if is_less "$have" "$need"; then
        abort "$name partition too small: need $need bytes, have $have bytes"
    fi
}
flash_part() {
    local name="$1" image="$2" block="$3"
    ui_print "   - Flashing $name"
    update_zip "$image" "$block" 1
    if [ $? -eq 0 ]; then
        ui_print "     Success"
    else
        abort "Failed to flash $name"
    fi
}
